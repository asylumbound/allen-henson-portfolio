# Copy to .env and fill in. Never commit the real file.

# Supabase -> Project Settings -> Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role (secret)
# Bypasses Row Level Security. Server/laptop only — never in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# https://dashboard.voyageai.com -> API Keys
VOYAGE_API_KEY=

# voyage-law-2 (1024 dims, legal-domain) is the default.
# Change it only if you also change the vector(1024) column in schema.sql.
EMBED_MODEL=voyage-law-2
