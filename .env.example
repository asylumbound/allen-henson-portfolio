# Set these in Railway before rotating any auth passwords.
# Legacy hardcoded defaults are still used when unset for backward compatibility,
# but those fallbacks are deprecated and should be removed after client auth is updated.
ADMIN_PASSWORD=change-me-admin
EDIT_PASSWORD=change-me-edit
EDITOR_PASSWORD=change-me-editor

# OpenAI — required for AI-generated alt text on image uploads.
# Without this, uploads continue to work but receive generic fallback alt text.
# Set this in Railway (or your deployment platform) to enable the feature.
OPENAI_API_KEY="sk-..."
